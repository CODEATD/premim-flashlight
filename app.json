{
  "expo": {
    "name": "Linterna Premium",
    "slug": "premium-flashlight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "premiumflashlight",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.codeatd.linternapremium",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.codeatd.linternapremium",
      "adaptiveIcon": {
        "backgroundColor": "#070707",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070707",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Linterna Premium necesita la cámara para encender el flash.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#070707",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9effd0b5-4e3b-494c-8d7e-873a18bb0ab5"
      }
    }
  }
}
